# Normalize all text files to LF on commit
* text=auto eol=lf

*.py         text eol=lf
*.sh         text eol=lf
*.yaml       text eol=lf
*.yml        text eol=lf
*.md         text eol=lf
*.json       text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.toml       text eol=lf

# Binary files — never diff or convert
*.png        binary
*.jpg        binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
