# Copy to smtp.env beside this file (git-ignored), fill it in, then: chmod 600 smtp.env
# alert_email.py reads it; `graph-goal.py contact "<address>"` proves it by sending a test email.
# Port 465 = TLS from the first byte; 587 = STARTTLS. One line per key, no spaces around "=".
SMTP_HOST=FILL_ME
SMTP_PORT=465
SMTP_USER=FILL_ME
SMTP_PASS=FILL_ME
SMTP_FROM=FILL_ME
SMTP_TO=FILL_ME
