#!/bin/sh
# Refs are the driver's. A builder's worktree gets this hook
# (Worktree.create, via `git config core.hooksPath` in the clone), and it
# refuses every ref write attempted from inside that worktree — a commit, a
# branch, a switch, a reset that would move HEAD — closing every way a
# builder holding `Bash(git *)` could move a ref out from under the driver.
# The driver's own git calls run with the repository itself as cwd, which
# never gets this hooksPath, so they are unaffected.
[ "$1" = prepared ] && { echo "refs are the driver's: no ref update from a builder worktree" >&2; exit 1; }
exit 0
